// Personal OS — hosted schema (PostgreSQL).
//
// Design notes:
//  * "Enum-like" fields are stored as TEXT and validated in the app layer
//    (see src/lib/enums.ts). This kept the schema portable through the
//    SQLite→PostgreSQL conversion and keeps every value readable in a backup.
//  * Dates that represent a *calendar day* are stored as `YYYY-MM-DD` strings
//    (`date` fields). Dates that represent an *instant* use DateTime. This
//    avoids the classic timezone drift where "today" shifts at UTC midnight.
//  * Every user-visible record carries createdAt/updatedAt so backups, sync and
//    "what changed this week" views are possible without extra bookkeeping.
//  * `externalId` + `source` columns exist on the health/workout tables so an
//    Apple Health / watch import can upsert idempotently without a migration.
//  * Nullable columns inside unique indexes rely on the default
//    NULLS DISTINCT semantics (two NULLs never collide) — the same behaviour
//    SQLite had. Never switch these indexes to NULLS NOT DISTINCT.
//  * The pre-web SQLite version of this schema is preserved at commit
//    f5b4fe1d950abf56cc11ae97d2750ac714d365fb (tag preview3-complete-before-web).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations connect directly; DATABASE_URL may point at a pooler in
  // production. Locally the two are simply the same URL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User & settings
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  /// The sign-in identifier. Kept nullable deliberately: a row without an
  /// email (or without a password) simply can never sign in — the credential
  /// check fails closed on null — and forcing NOT NULL here would make the
  /// migration fail on any historical row rather than harmlessly stranding
  /// it. Every account created through public sign-up has one.
  email     String?  @unique
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- authentication (in-app password, Auth.js credentials) -----------------
  /// scrypt hash in the self-describing `scrypt$logN$r$p$salt$hash` format
  /// (src/server/auth/password.ts). Sign-up always sets one; an account
  /// without one (a legacy or imported row) simply cannot sign in.
  passwordHash      String?
  /// Bumped on password change/reset and "sign out everywhere". Sessions are
  /// stateless JWTs carrying this value; a mismatch on any request means the
  /// token was issued before the bump and is treated as signed out.
  tokenVersion      Int       @default(0)
  /// Consecutive failed sign-in attempts; reset on success and when an
  /// expired lockout is first observed (so the threshold after a lockout is
  /// a full window again, not a single failure).
  failedLoginCount  Int       @default(0)
  /// While set and in the future, every sign-in attempt fails — including
  /// ones with the correct password — with the same generic message.
  lockedUntil       DateTime?
  passwordUpdatedAt DateTime?
  /// "Was that me?" — the per-account audit trail, shown in Settings.
  lastLoginAt       DateTime?
  lastFailedLoginAt DateTime?

  // Personal context used by nutrition / health calculations.
  birthDate     String? // YYYY-MM-DD
  heightCm      Float?
  sex           String? // male | female | other
  activityLevel String  @default("moderate") // sedentary | light | moderate | active | athlete

  // UI preferences
  theme          String @default("system") // light | dark | system
  weekStartsOn   Int    @default(1) // 0 = Sunday, 1 = Monday
  unitSystem     String @default("imperial") // imperial | metric
  dayStartHour   Int    @default(6)
  dayEndHour     Int    @default(22)

  scheduleItems     ScheduleItem[]
  scheduleTemplates ScheduleTemplate[]
  habits            Habit[]
  habitLogs         HabitLog[]
  foodItems         FoodItem[]
  meals             Meal[]
  mealTemplates     MealTemplate[]
  workouts          Workout[]
  workoutTemplates  WorkoutTemplate[]
  healthMetrics     HealthMetric[]
  healthRecords     HealthRecord[]
  goals             Goal[]
  daySummaries      CalendarDaySummary[]
  journalEntries    JournalEntry[]
  reminders         Reminder[]
  reminderDeliveries ReminderDelivery[]
  favorites         FavoriteItem[]
  tags              Tag[]
  scheduleRules     ScheduleRule[]
  scheduleOverrides ScheduleOverride[]
  seedBatches       SeedBatch[]
  healthImportBatches HealthImportBatch[]
  healthImportSessions HealthImportSession[]
  pushSubscriptions PushSubscription[]
  recoveryCodes     RecoveryCode[]
  projects          Project[]
  tasks             Task[]
  financeAccounts   FinanceAccount[]
  financeTransactions FinanceTransaction[]
  bills             Bill[]
  savingsGoals      SavingsGoal[]
  budgets           Budget[]
  financeImportBatches FinanceImportBatch[]
  inboxItems        InboxItem[]
  documents         LifeDocument[]

  // --- day score configuration ----------------------------------------------
  /// JSON map of category → weight, e.g. {"planner":30,"habits":30,"goals":40}.
  /// Null/empty means "weight every applicable category equally", which is the
  /// default and needs no explanation beyond that sentence.
  scoreWeights String?
  /// Whether low-priority planner items count toward the day score.
  scoreOptionalTasks Boolean @default(false)
  /// JSON blob backing the dismissible onboarding checklist.
  onboardingState String @default("{}")
}

// Authentication is in-app email+password (no OAuth provider, no Account
// table) and sessions are stateless JWTs — there is no Session table on
// purpose. The former Google-era Account table was dropped by the
// password_auth migration; it only ever held token-stripped link rows.

/// One password-recovery code. Codes are the app's "forgot password" proof —
/// no email infrastructure, no paid provider: a batch is generated at
/// sign-up (and regenerable from Settings), shown to the user exactly once,
/// and only a SHA-256 hash of each code is stored. Each code carries ≈79
/// bits of randomness (src/server/auth/recovery-codes.ts), so a fast hash is
/// safe and lets redemption look the code up directly by its unique hash.
/// Redeeming one marks it used; it never works twice.
model RecoveryCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex of the normalized (lowercased, separator-stripped) code.
  codeHash String @unique
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Fixed-window rate-limit counter, keyed by scope (e.g. a hashed client IP
/// for sign-up). Stored in the database because serverless instances share
/// nothing else — an in-memory counter would reset on every cold start.
/// Rows are upserted in place and expired rows are reused, so the table
/// stays tiny. See src/server/auth/rate-limit.ts.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

// ---------------------------------------------------------------------------
// Scheduling — one shared engine for goals and habits
// ---------------------------------------------------------------------------

/// An effective-dated schedule version. Changing a schedule never edits a row:
/// it closes the current rule (`effectiveTo` = the day before the change) and
/// opens a new one, so a date in the past keeps resolving against the rule that
/// was actually in force then and historical scores stay stable.
///
/// `ownerType` + `ownerId` is a deliberate polymorphic link rather than two
/// parallel table families: goals and habits answer "does this apply on this
/// date?" identically, and one table is what makes one authoritative engine
/// possible. See src/lib/logic/schedule.ts.
model ScheduleRule {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// goal | habit
  ownerType String
  ownerId   String

  /// Inclusive first day this version applies, `YYYY-MM-DD`.
  effectiveFrom String
  /// Inclusive last day this version applies. Null = still in force.
  effectiveTo   String?

  /// every_day | weekdays | times_per_week | one_time | interval_days |
  /// interval_weeks | monthly
  mode String @default("every_day")

  /// For interval_days / interval_weeks: repeat every N, anchored on
  /// `effectiveFrom`.
  interval Int @default(1)
  /// For times_per_week: how many completions in the week count as success.
  timesPerWeek Int?
  /// For monthly: day-of-month, clamped to the last day of short months.
  monthDay Int?

  enabled Boolean @default(true)

  /// morning | afternoon | evening | before_bed | anytime
  daypart String @default("anytime")
  /// Optional explicit time, minutes from midnight.
  timeMinute Int?

  reminderEnabled Boolean @default(false)
  /// Minutes from midnight the reminder should fire.
  reminderMinute  Int?

  /// Selected weekdays for `weekdays` mode — rows, not a comma-separated list,
  /// so "which goals apply on Wednesday?" is a real query.
  days ScheduleRuleDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, ownerType, ownerId, effectiveFrom])
  @@index([ownerType, ownerId])
}

model ScheduleRuleDay {
  ruleId String
  rule   ScheduleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday.
  weekday Int

  @@id([ruleId, weekday])
  @@index([weekday])
}

/// A one-date exception that never touches the repeating schedule.
model ScheduleOverride {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// goal | habit
  ownerType String
  ownerId   String
  date      String // YYYY-MM-DD

  /// rest      — scheduled day converted to a rest day (neutral, no penalty)
  /// excused   — legitimately prevented; also the "skip without penalty"
  ///             action. Neutral: no credit, but the streak survives.
  /// activate  — force-active on an otherwise unscheduled date
  /// cancel    — this occurrence does not exist at all
  /// reschedule— this occurrence moved to `movedToDate`
  ///
  /// Note: a *penalised* skip is not an override. It is a completion record
  /// (HabitLog.status = "skipped"), because the occurrence really was
  /// scheduled and really was not done.
  kind String

  movedToDate String?
  timeMinute  Int?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerType, ownerId, date])
  @@index([userId, date])
}

// ---------------------------------------------------------------------------
// Demo / seed data identification
// ---------------------------------------------------------------------------

/// Demo records are identified by relationship, never by guessing at their
/// names, so "remove sample data" can delete exactly what it created and
/// nothing a real user typed.
model SeedBatch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label String
  /// demo | starter
  kind  String @default("demo")

  records SeedRecord[]

  createdAt DateTime @default(now())

  @@index([userId, kind])
}

model SeedRecord {
  id      String    @id @default(cuid())
  batchId String
  batch   SeedBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// Prisma model name, e.g. "ScheduleItem".
  model    String
  recordId String

  @@unique([model, recordId])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Tags — shared across planner items, habits, workouts and journal entries.
// ---------------------------------------------------------------------------

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  color String @default("slate")

  createdAt DateTime @default(now())

  scheduleItems ScheduleItemTag[]
  tasks         TaskTag[]

  @@unique([userId, name])
  @@index([userId])
}

model ScheduleItemTag {
  scheduleItemId String
  tagId          String

  scheduleItem ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([scheduleItemId, tagId])
  @@index([tagId])
}

/// The same `Tag` rows, on tasks. Tags are labels, not containers: a task has
/// exactly one project (the container) and any number of tags (the lenses),
/// which is what keeps this from becoming a second project system. Both sides
/// are user-scoped, so a join row can never bridge two accounts — the action
/// layer verifies both ids belong to the caller before writing one.
model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Planner
// ---------------------------------------------------------------------------

model ScheduleItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  notes String?

  /// Calendar day this item lives on, `YYYY-MM-DD`.
  date String

  /// Minutes from midnight. Null on both when the item is all-day.
  startMinute Int?
  endMinute   Int?
  allDay      Boolean @default(false)

  category String  @default("personal") // work | personal | health | fitness | meal | learning | admin | social | rest
  priority String  @default("medium") // low | medium | high | urgent
  status   String  @default("planned") // planned | done | skipped
  color    String? // optional per-item accent override

  /// Manual ordering within a day (drag & drop).
  sortOrder Int @default(0)

  completedAt DateTime?

  // --- recurrence -----------------------------------------------------------
  /// Recurrence rule on the *series parent*. See src/lib/logic/recurrence.ts.
  /// e.g. { freq: "weekly", interval: 1, byWeekday: [1,3,5], until: "2026-12-31" }
  recurrenceRule String?
  /// When set, this row is a materialised occurrence of `seriesId`.
  seriesId       String?
  series         ScheduleItem?  @relation("Series", fields: [seriesId], references: [id], onDelete: Cascade)
  occurrences    ScheduleItem[] @relation("Series")
  /// Occurrence was detached from the series and edited independently.
  isException    Boolean        @default(false)

  // --- links to other domains ----------------------------------------------
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)
  workoutId String?  @unique
  workout   Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  mealId    String?  @unique
  meal      Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)

  templateId String?
  template   ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Set when this block was created from a task ("add to planner"). The item
  /// stays an ordinary planner block — no scheduling logic rides this link;
  /// it only records where the block came from. Deleting the task keeps the
  /// block (SetNull); completing either side never touches the other.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// Stable identity of a row stamped onto this day by a routine, formatted
  /// `<application ordinal>:<row index>` — e.g. `1:0` is the first row of the
  /// first application, `2:0` the same row applied a deliberate second time.
  /// Null for anything that did not come from a routine. Together with the
  /// unique constraint below this is what makes applying a routine twice a
  /// no-op instead of a silent double.
  sourceKey String?

  tags      ScheduleItemTag[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, templateId, sourceKey])
  @@index([userId, date])
  @@index([userId, status])
  @@index([seriesId])
  @@index([taskId])
}

/// A reusable block (or whole routine) that can be stamped onto any day.
model ScheduleTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String  @default("personal")
  /// JSON array of template items: [{ title, startMinute, endMinute, category, priority, notes }]
  items       String  @default("[]")
  icon        String?

  useCount Int      @default(0)
  lastUsed DateTime?

  scheduleItems ScheduleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Habits
// ---------------------------------------------------------------------------

model Habit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String  @default("health") // health | productivity | learning | hygiene | mindfulness | personal
  icon        String  @default("Check")
  color       String  @default("emerald")

  /// morning | afternoon | evening | before_bed | anytime
  timeOfDay String @default("anytime")

  // --- recurrence (LEGACY MIRROR) -------------------------------------------
  // `ScheduleRule` (ownerType = "habit") is the authoritative schedule and the
  // only thing the engine reads. These three columns are kept, and rewritten on
  // every save, so that backups taken before the upgrade still restore and the
  // raw database stays readable on its own. Never read them for scheduling.
  frequency String @default("daily") // daily | weekly | custom
  /// For `custom`: JSON array of weekday numbers, 0=Sun … 6=Sat.
  weekdays  String @default("[0,1,2,3,4,5,6]")
  /// For `weekly`: how many times per week counts as a success.
  targetPerWeek Int @default(7)

  /// Optional numeric target, e.g. "8" glasses of water.
  targetValue Float?
  unit        String?

  archived  Boolean @default(false)
  sortOrder Int     @default(0)

  startDate String // YYYY-MM-DD
  endDate   String?

  logs          HabitLog[]
  scheduleItems ScheduleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archived])
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   String // YYYY-MM-DD
  /// done    — completed (counts positively, extends the streak)
  /// skipped — deliberately not done (breaks the streak, like a miss)
  /// excused — legitimately prevented (neutral: no credit, no broken streak)
  /// missed  — explicitly recorded as missed
  status String @default("done")
  value  Float?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date])
  @@index([userId, date])
}

// ---------------------------------------------------------------------------
// Nutrition
// ---------------------------------------------------------------------------

/// A food in the local database. Nutrition values are always **per 100 g** for
/// weight-based foods, or per `servingSize` `servingUnit` for count-based ones
/// (`basis` tells you which). Keeping one canonical basis makes serving math
/// trivial and prevents the classic "per serving vs per 100g" bug.
model FoodItem {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  brand       String?
  description String?

  /// Where this row came from: "local" (bundled) | "custom" (user-made) |
  /// "usda" | "off". Provider + externalId is the identity of an imported food.
  provider   String  @default("local")
  /// The provider's own id — an FDC id, or an Open Food Facts barcode. Null for
  /// local and custom foods, and SQLite treats NULLs as distinct in a unique
  /// index, so they never collide with each other.
  externalId String?
  barcode    String?
  /// "generic" (an ingredient — chicken breast, oats) | "branded" (a product).
  kind       String  @default("generic")
  /// Human-readable attribution shown in the UI, e.g. "USDA FoodData Central".
  source     String?
  /// When the provider record was first pulled, and when it was last refreshed.
  /// A refresh updates the food but never a `MealEntry` already logged from it.
  retrievedAt DateTime?
  refreshedAt DateTime?
  /// JSON: nutrients beyond the seven first-class columns — saturated fat,
  /// cholesterol, potassium, calcium, iron, vitamins. Kept whole rather than
  /// discarded, because the provider will not always be reachable later.
  extraNutrients String?
  /// JSON: serving options the provider declared (household measures, package
  /// size). Only ones with a trustworthy gram weight are offered as conversions.
  servingOptions String?
  /// 0–1: how much of the core nutrient set the provider actually supplied.
  /// Community data is often partial, and the UI says so rather than implying 0.
  completeness Float?
  /// True when the row exists only because a provider result was cached.
  cached Boolean @default(false)

  /// "per_100g" | "per_serving" | "per_package" | "per_item"
  basis String @default("per_100g")

  /// Default serving used when logging, expressed in grams for per_100g foods.
  servingSize Float  @default(100)
  servingUnit String @default("g")
  servingLabel String? // "1 medium (118 g)"

  calories Float
  protein  Float @default(0)
  carbs    Float @default(0)
  fat      Float @default(0)
  fiber    Float @default(0)
  sugar    Float @default(0)
  sodium   Float @default(0) // mg

  category String  @default("other") // protein | grain | vegetable | fruit | dairy | fat | snack | beverage | supplement | prepared | other
  isCustom Boolean @default(false)
  verified Boolean @default(false)
  /// Free-text search helper: lowercase name + brand + aliases.
  searchKey String @default("")

  entries      MealEntry[]
  templateRows MealTemplateItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([searchKey])
  @@index([userId])
  @@index([barcode])
}

model Meal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date String // YYYY-MM-DD
  /// breakfast | lunch | dinner | snack | custom
  type  String @default("breakfast")
  /// Free label for `custom` (e.g. "Pre-workout").
  label String?
  time  String? // HH:mm
  notes String?

  entries      MealEntry[]
  scheduleItem ScheduleItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model MealEntry {
  id     String @id @default(cuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Restrict)

  /// Quantity in `unit`. For per_100g foods the unit is grams unless the user
  /// picks "serving", in which case quantity is multiplied by servingSize.
  quantity Float  @default(1)
  unit     String @default("serving") // serving | g | ml | oz | piece

  /// Denormalised macros at log time so editing a food later never rewrites
  /// history. Computed by src/lib/logic/nutrition.ts.
  calories Float
  protein  Float
  carbs    Float
  fat      Float
  fiber    Float @default(0)
  sugar    Float @default(0)
  sodium   Float @default(0)

  /// The rest of the snapshot taken when this entry was logged. A provider
  /// refresh, a renamed custom food or a corrected serving size must never
  /// silently move a total that has already been recorded, so everything the
  /// entry was computed from is frozen here alongside the macros above.
  foodNameAtLog       String?
  basisAtLog          String?
  servingSizeAtLog    Float?
  servingUnitAtLog    String?
  /// Resolved grams for this entry, when the unit could be converted at all.
  gramsAtLog          Float?
  /// JSON: the extra nutrients scaled to this entry, frozen the same way.
  extraNutrientsAtLog String?

  /// Client-generated per-save key. A double-click, a retry and a resubmitted
  /// form all carry the same one, so the unique index below rejects the second
  /// write instead of relying on a disabled button.
  idempotencyKey String?

  /// Meal-template application identity, mirroring `ScheduleItem.sourceKey`:
  /// `<application ordinal>:<row index>`. Applying a template twice by accident
  /// collides; a deliberate second copy takes the next ordinal and does not.
  templateId String?
  sourceKey  String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mealId, idempotencyKey])
  @@unique([mealId, templateId, sourceKey])
  @@index([mealId])
}

model MealTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  mealType String @default("breakfast")
  notes    String?

  items MealTemplateItem[]

  useCount Int       @default(0)
  lastUsed DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MealTemplateItem {
  id         String       @id @default(cuid())
  templateId String
  template   MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  quantity Float  @default(1)
  unit     String @default("serving")

  @@index([templateId])
}

// ---------------------------------------------------------------------------
// Workouts
// ---------------------------------------------------------------------------

model Workout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date String // YYYY-MM-DD
  time String? // HH:mm

  name String
  /// strength | cardio | walking | running | cycling | swimming | yoga | mobility | sport | hiit | custom
  type String @default("strength")

  durationMin    Int     @default(0)
  intensity      String  @default("moderate") // easy | moderate | hard | max
  caloriesBurned Int?
  avgHeartRate   Int?
  maxHeartRate   Int?
  distanceKm     Float?
  elevationM     Float?
  perceivedEffort Int?   // RPE 1-10
  notes          String?

  /// planned | in_progress | completed | abandoned | skipped
  ///
  /// `in_progress` is a live session: it exists from the moment you start
  /// training until you finish or abandon it. Only one can be open at a time.
  status String @default("completed")

  /// Wall-clock bounds of a session. `durationMin` above stays the number the
  /// rest of the app reads (the score, insights, the calendar), but for a
  /// session it is *derived* from these on finish rather than typed in — a
  /// workout you actually did has a real length.
  startedAt   DateTime?
  completedAt DateTime?

  /// Rest between sets, in seconds, carried from the template so the session's
  /// timer has something to count down. Null means "no timer".
  restSecDefault Int?

  // Import-friendly: an Apple Health / watch export can upsert on
  // (userId, source, externalId) without touching manual rows. Scoped per
  // user — two accounts importing the same Apple Health export must never
  // collide with each other.
  source     String  @default("manual") // manual | apple_health | import
  externalId String?

  /// Set when this workout arrived via a health import, so removing that batch
  /// can take its workouts with it while leaving manual workouts untouched.
  importBatchId String?

  sets         WorkoutSet[]
  scheduleItem ScheduleItem?

  templateId String?
  template   WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source, externalId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([importBatchId])
}

model WorkoutSet {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exercise  String
  setNumber Int    @default(1)

  /// What actually happened. During a session these stay null until the set is
  /// ticked off; for a workout logged after the fact they are filled straight in.
  reps       Int?
  weightKg   Float?
  durationSec Int?
  distanceM  Float?
  restSec    Int?
  rpe        Float?
  notes      String?

  /// What the plan asked for, kept separate from what was done. A session shows
  /// the target next to the input, and "3×8 @ 60 planned, 3×8 @ 62.5 done" stays
  /// legible afterwards instead of the plan being overwritten by the outcome.
  targetReps     Int?
  targetWeightKg Float?

  /// Defaults true so a workout logged after the fact is complete on arrival —
  /// which is how every row before Phase 10 was written. A session creates its
  /// sets with `false` and ticks them off.
  completed  Boolean @default(true)
  /// When the set was ticked. Drives the rest timer, and is what makes a
  /// session's elapsed time reconstructable rather than guessed.
  completedAt DateTime?

  sortOrder Int @default(0)

  @@index([workoutId])
}

model WorkoutTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  type        String  @default("strength")
  description String?
  durationMin Int     @default(45)
  intensity   String  @default("moderate")
  /// JSON array: [{ exercise, sets, reps, weightKg, restSec, notes }]
  exercises   String  @default("[]")

  useCount Int       @default(0)
  lastUsed DateTime?

  workouts Workout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Health
// ---------------------------------------------------------------------------

/// One metric reading. Deliberately generic (EAV-ish) so new metric types need
/// no migration and an Apple Health export maps 1:1 onto rows.
model HealthMetric {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Reporting day. For a sleep interval that crosses midnight this is the day
  /// the interval *ends* — the night belongs to the morning you woke up on.
  date String // YYYY-MM-DD
  /// steps | active_calories | resting_calories | sleep_hours | resting_hr |
  /// heart_rate | hrv | body_weight | body_fat | hydration_ml | distance_km |
  /// blood_pressure | mood | energy
  type  String
  /// Stored in the metric's canonical unit (see HEALTH_METRIC_RULES in
  /// src/lib/logic/health.ts). Legacy rows may carry other units; `unit` says
  /// which, and aggregation converts before combining anything.
  value Float
  unit  String @default("")

  /// Sub-classification within a type — sleep stages use
  /// in_bed | asleep | awake | core | deep | rem. Null for plain readings.
  subtype String?

  /// Optional secondary value, e.g. diastolic for blood pressure.
  secondaryValue Float?
  /// Range of the day's samples where the row summarises many (heart rate).
  minValue Float?
  maxValue Float?
  notes    String?

  /// Instant of the reading when known; otherwise the day is enough.
  recordedAt DateTime?
  /// Interval bounds for records that cover a span (sleep, summed samples).
  startAt DateTime?
  endAt   DateTime?

  /// Where the number came from: manual | apple_health | csv | workout |
  /// calculated | estimated. Estimated or manual data is never presented as a
  /// device measurement — the UI labels every value with this field.
  source     String  @default("manual")
  /// The app that recorded it (Apple Health sourceName, or the CSV's `source`
  /// column) — distinct devices are separate groups so phone + watch never
  /// double-count.
  sourceApp    String?
  sourceDevice String?
  externalId   String?

  /// How many raw samples were folded into this row at import time.
  sampleCount Int?

  /// Stable deduplication key. Re-importing the same file upserts onto the same
  /// fingerprints instead of duplicating; manual daily entries use
  /// `manual|type|date` so logging again replaces the day's value. Nullable —
  /// SQLite treats NULLs as distinct, so rows without one never collide.
  fingerprint String?

  batchId String?
  batch   HealthImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId, type, date])
  @@index([userId, date])
  @@index([batchId])
}

/// One in-flight health import between "the browser parsed the file" and
/// "the user confirmed". The raw export never leaves the user's device: the
/// browser parses it in a Web Worker and uploads only normalised rows, in
/// bounded chunks, into a session created by — and owned by — the server.
/// Sessions expire after two hours and are swept opportunistically; confirm
/// and cancel both delete the staged data.
model HealthImportSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// uploading → staged → (deleted on confirm/cancel). A failed confirm keeps
  /// the session so the user can retry without re-parsing.
  status String @default("uploading")

  source   String // apple_health | csv
  fileType String // xml | zip | csv
  /// Base filename only — never a path from the user's machine.
  fileName String
  fileSize Int?

  /// Chunks the client declared at creation; all must arrive before finalize.
  totalChunks Int @default(0)

  examined Int    @default(0)
  invalid  Int    @default(0)
  /// JSON array [{type, count}] of unsupported record types.
  unsupported String @default("[]")
  /// JSON array of parser warnings (bounded).
  warnings String @default("[]")

  /// After finalize: the server-validated plan (rows, workouts, dupe lists)
  /// the confirm step writes from. Never the raw file.
  stagedPlan String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks HealthImportChunk[]

  @@index([userId, status])
  @@index([expiresAt])
}

/// One bounded slice of normalised rows uploaded by the browser. The unique
/// (sessionId, seq) makes an accidental duplicate submission a no-op.
model HealthImportChunk {
  id        String              @id @default(cuid())
  sessionId String
  session   HealthImportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  seq     Int
  /// JSON: { rows: NormalizedHealthRow[], workouts: RawWorkout[] }
  payload String

  createdAt DateTime @default(now())

  @@unique([sessionId, seq])
}

/// One import run — the unit of review and of removal. Only counts and safe
/// metadata are kept; the raw export is parsed in the browser and never
/// stored anywhere server-side.
model HealthImportBatch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source   String // apple_health | csv
  fileType String // xml | zip | csv
  /// Base filename only — never a path from the user's machine.
  fileName String
  fileSize Int?

  /// completed | failed | removed
  status String @default("completed")
  error  String?

  dateFrom String?
  dateTo   String?
  /// JSON array of the metric types the user selected (plus "workouts").
  categories String @default("[]")

  /// Raw records examined in the file, before rollup.
  examined Int @default(0)
  /// Normalised rows newly written.
  imported Int @default(0)
  /// Existing rows a re-import refreshed with a fuller value.
  updated Int @default(0)
  /// Rows already present and unchanged — the same file imported twice.
  duplicates Int @default(0)
  /// Records of types Personal OS does not track.
  skipped Int @default(0)
  /// Rows that failed validation.
  invalid Int @default(0)

  workoutsImported Int @default(0)
  workoutsSkipped  Int @default(0)

  /// JSON array of human-readable warnings shown at import time.
  warnings String @default("[]")
  /// JSON array of non-fatal errors (a member file that would not parse, a
  /// record that could not be read) — kept apart from warnings so the history
  /// can show "it worked, but…" distinctly from "it did not work".
  errors String @default("[]")

  /// Non-metric records this run wrote (ECGs, medications, clinical records,
  /// workout routes). Counted separately because they are not days of numbers.
  recordsImported Int @default(0)
  recordsDuplicate Int @default(0)

  /// Wall-clock of the run itself, so the history can show how long a
  /// multi-gigabyte export actually took rather than only when it finished.
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?

  /// Bytes of `export.xml` the streaming parser read. A useful, non-identifying
  /// measure of how big the export really was once unzipped.
  xmlBytes BigInt?
  /// Member files the archive contained that this app does not read.
  ignoredFiles String @default("[]")

  removedAt DateTime?

  /// Undo stamp — the same shape finance import batches carry. Set once; a
  /// second undo is a no-op rather than a way to reach rows a later import
  /// wrote onto the same fingerprints.
  undoneAt    DateTime?
  undoneCount Int       @default(0)
  keptCount   Int       @default(0)

  metrics HealthMetric[]
  records HealthRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
}

/// A health record that is not a number-per-day: an ECG's summary, a
/// medication entry, a clinical record from a connected provider, or a
/// workout's route metadata.
///
/// Sleep and mindfulness sessions are deliberately NOT here: they are already
/// intervals in `HealthMetric` (with stages, bounds and a source), and the
/// Sleep page derives its per-night sessions from those rows rather than
/// storing the same night twice.
///
/// One table rather than five keeps the ownership rule, the backup, the undo
/// and the search path identical for every kind — the same reason "enum-like"
/// columns are TEXT everywhere else in this schema. `detail` holds the
/// kind-specific fields as JSON; nothing in the app parses it into behaviour,
/// it is only ever displayed.
///
/// Deliberately NOT stored: ECG voltage traces, GPS coordinates, and the raw
/// clinical FHIR payload. Those are the parts of an export whose value to this
/// app is nil and whose sensitivity is highest, so the importer reads their
/// metadata and drops the body.
model HealthRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ecg | medication | clinical | workout_route | mindful_session | sleep_session
  kind String

  /// Reporting day, so a record sits on the timeline with everything else.
  date String // YYYY-MM-DD
  recordedAt DateTime?
  startAt    DateTime?
  endAt      DateTime?

  /// What the record is, in one line — "Sinus rhythm", "Metformin 500 mg".
  title String
  /// Secondary line: the classification, the issuer, the provider.
  subtitle String?
  /// Optional single number the kind is measured by (ECG average bpm, route
  /// distance in km, session minutes). Null when the kind has no such number.
  value Float?
  unit  String @default("")

  /// JSON object of kind-specific fields, bounded at write time. Display only.
  detail String @default("{}")

  /// manual | apple_health | csv — same vocabulary as HealthMetric.source.
  source     String  @default("apple_health")
  sourceApp  String?
  externalId String?

  /// Stable deduplication key, same contract as HealthMetric.fingerprint:
  /// re-importing the same export upserts onto the same row instead of
  /// duplicating. Nullable, and NULLs are distinct.
  fingerprint String?

  batchId String?
  batch   HealthImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId, kind, date])
  @@index([userId, date])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Goals, summaries, journal, reminders, favorites
// ---------------------------------------------------------------------------

model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// nutrition | workout | habit | health | planner
  domain String
  /// e.g. "calories", "protein", "workouts_per_week", "steps", "body_weight"
  metric String
  label  String

  description String?

  target    Float
  /// Upper bound for `range` comparisons ("2,000–2,300 kcal"). Null otherwise.
  targetMax Float?
  unit      String @default("")
  /// gte | lte | eq | range | boolean — how to score progress against target.
  /// (`boolean` = done / not done, no numeric target.)
  direction String @default("gte")
  /// daily | weekly | monthly. A `times_per_week` schedule always evaluates
  /// weekly regardless of this field; see resolveGoalPeriod().
  period    String @default("daily")

  /// Where the number comes from. The app fills goals in from data it already
  /// has rather than asking the user to tick a box it can already prove:
  /// manual | workout_count | workout_minutes | workout_distance | steps |
  /// active_calories | sleep_hours | hydration | calories | protein | carbs |
  /// fat | fiber | habit | planner_required
  source String @default("manual")
  /// For `habit` goals: the habit id. Otherwise null.
  sourceRef String?

  /// The goal's own lifespan. Distinct from a ScheduleRule's effective window,
  /// which versions the *schedule* rather than the goal.
  startDate String?
  endDate   String?

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  archivedAt DateTime?

  entries GoalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: deliberately *not* unique on (userId, domain, metric, period).
  // "Complete a workout on Mon/Tue/Thu/Fri" and "4 workouts per week" are two
  // legitimate simultaneous goals over the same metric.
  @@index([userId, domain, metric])
  @@index([userId, active])
}

/// A user-recorded outcome for one goal on one date.
///
/// Only needed for goals the app cannot prove from data it already has
/// (`source = "manual"`), and for recording a deliberate skip or an excuse
/// against a goal that otherwise scores automatically. Goals with a real
/// completion source are never asked to be ticked by hand.
model GoalEntry {
  id     String @id @default(cuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId String

  date String // YYYY-MM-DD
  /// done | skipped | excused
  status String @default("done")
  value  Float?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goalId, date])
  @@index([userId, date])
}

/// Precomputed per-day rollup that powers the calendar heatmap and insights
/// without scanning every table. Recomputed on write (see server/actions).
model CalendarDaySummary {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date String // YYYY-MM-DD

  plannedCount   Int @default(0)
  completedCount Int @default(0)
  skippedCount   Int @default(0)

  habitsDue  Int @default(0)
  habitsDone Int @default(0)

  calories Float @default(0)
  protein  Float @default(0)
  carbs    Float @default(0)
  fat      Float @default(0)

  workoutCount    Int @default(0)
  workoutMinutes  Int @default(0)
  caloriesBurned  Int @default(0)

  steps      Float?
  sleepHours Float?
  bodyWeight Float?

  /// 0–100 day score for the heatmap, produced by src/server/day-score.ts.
  ///
  /// Read it together with `scoreApplicable`: when that is 0 the day had no
  /// applicable opportunity at all, and this column's 0 means "open day", not
  /// "scored zero". Averaging those days in as zero is exactly the bug this
  /// pair of columns exists to prevent.
  score Int @default(0)

  /// Opportunities that actually applied on this day.
  scoreApplicable Int @default(0)
  scoreCompleted  Int @default(0)
  scoreMissed     Int @default(0)
  scorePending    Int @default(0)
  /// Records excluded with a reason (rest day, not scheduled, optional…).
  scoreExcluded   Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model JournalEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date    String // YYYY-MM-DD
  title   String?
  content String  @default("")
  mood    Int? // 1–5
  energy  Int? // 1–5
  /// JSON array of free-text tags.
  tags    String  @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Reminder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String?
  /// Local wall-clock instant the reminder should fire.
  remindAt DateTime
  /// none | daily | weekdays | weekly
  repeat   String   @default("none")

  scheduleItemId String?
  scheduleItem   ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)

  enabled     Boolean   @default(true)
  lastFiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
}

/// One row per delivered reminder occurrence. The unique key is what makes
/// delivery exactly-once across reloads and re-renders: `habit:<id>:<date>`,
/// `goal:<id>:<date>` or `reminder:<id>:<instant>`.
model ReminderDelivery {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key         String
  deliveredAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, deliveredAt])
}

/// One browser's Web Push subscription. Endpoint + keys come from the
/// browser's PushManager; the endpoint is an opaque provider URL, unique per
/// browser+profile. A push failure with 404/410 means the browser revoked it —
/// the row is deleted rather than retried forever.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  /// Coarse device label shown in Settings ("Chrome · Mac"), from the
  /// user agent at subscribe time. Never a full fingerprint.
  deviceLabel String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Tasks & projects
// ---------------------------------------------------------------------------

/// A container for related tasks. Deliberately light: grouping, a colour and a
/// lifecycle — structure lives on the tasks themselves. Deleting a project
/// never deletes its tasks (they fall back to standalone), because a task you
/// wrote down is yours even after the project around it dissolves.
model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  color       String @default("slate")

  /// active | completed | archived (validated in src/lib/enums.ts)
  status      String    @default("active")
  completedAt DateTime?

  sortOrder Int @default(0)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// One actionable item. Distinct from a planner ScheduleItem on purpose: a
/// schedule item occupies a slot in a day; a task is an obligation that may
/// have a due date but no slot. The two systems stay separate so neither
/// inherits the other's semantics (recurrence-by-materialisation, day scores).
model Task {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Subtasks: one level in the UI, enforced in the action layer rather than
  /// the schema (the column supports deeper nesting if a later phase wants it).
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  title String
  notes String?

  /// open | done | dropped
  status String @default("open")
  /// low | medium | high | urgent — the planner's priority scale, reused.
  priority String @default("medium")

  dueDate     String? // YYYY-MM-DD
  completedAt DateTime?

  /// none | daily | weekly | monthly | yearly. Completing a repeating task
  /// advances `dueDate` to the next occurrence instead of closing the row.
  repeat      String @default("none")
  /// Repeat every N units (every 2 weeks = weekly / 2).
  repeatEvery Int    @default(1)
  /// The due date the repeat was configured against. Advancing generates
  /// occurrences from this anchor, so "monthly on the 31st" clamps to short
  /// months without drifting to the 28th forever.
  repeatAnchor String?

  /// Opt-in per task: remind on the due date (see src/lib/logic/reminders.ts).
  reminderEnabled Boolean @default(false)

  sortOrder Int @default(0)

  /// Planner blocks created from this task ("add to planner") and inbox
  /// captures this task was converted from. Both links are informational —
  /// deleting the task merely unlinks them.
  scheduleItems ScheduleItem[]
  inboxItems    InboxItem[]

  /// Free-form labels, shared with the planner's tag vocabulary.
  tags TaskTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([projectId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Finance — manual-first: accounts, a signed transaction ledger, bills,
// savings goals. No bank sync, no third-party integration, by design.
// ---------------------------------------------------------------------------

/// A place money lives. `type` covers debt too: a credit_card or loan account
/// simply carries a negative balance — one model, one net-worth sum.
model FinanceAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  /// checking | savings | cash | credit_card | investment | loan | other
  type String @default("checking")
  /// ISO 4217 code, display-only — the app never converts between currencies.
  currency String @default("USD")

  /// Balance before the first recorded transaction. The current balance is
  /// always `openingBalance + sum(transactions)` — computed, never stored, so
  /// it cannot drift from the ledger. "Set balance" writes an adjustment
  /// transaction rather than editing this.
  openingBalance Float @default(0)

  /// Remind when the computed balance sits below this amount (in the
  /// account's own currency). Null = no low-balance reminder. Delivery rides
  /// the reminder ledger, at most once per week per account — see
  /// resolveLowBalanceReminder in src/lib/logic/reminders.ts.
  lowBalanceThreshold Float?

  notes      String?
  archivedAt DateTime?
  sortOrder  Int       @default(0)

  transactions  FinanceTransaction[]
  bills         Bill[]
  importBatches FinanceImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// One ledger entry. `amount` is signed: positive is money in, negative is
/// money out. Summaries derive income/spending from the sign, so there is no
/// separate "type" column to disagree with it.
model FinanceTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Set when this payment settled a bill occurrence — the bill's payment
  /// history without a second bookkeeping table.
  billId String?
  bill   Bill?   @relation(fields: [billId], references: [id], onDelete: SetNull)

  date   String // YYYY-MM-DD
  amount Float // signed; never zero (validated in the action layer)

  /// Merchant / counterparty, free text. What a future CSV import maps its
  /// description column onto.
  payee    String?
  /// See FINANCE_CATEGORIES in src/lib/enums.ts.
  category String  @default("other")
  notes    String?

  /// CSV import identity: a deterministic fingerprint of the imported row so
  /// re-importing the same file skips instead of duplicating. Null for
  /// manual entries (NULLS DISTINCT — they never collide). Format:
  /// `v1|<accountId>|<date>|<amount>|<payee>|<occurrence>` — see
  /// src/lib/logic/finance-import.ts.
  importKey String?

  /// Both legs of an account transfer share one group id — that is what makes
  /// a transfer atomic to delete and impossible to half-edit. Null for
  /// everything that is not a transfer leg. Transfer legs carry category
  /// `transfer`, which every income/spending summary excludes.
  transferGroupId String?

  /// The CSV import batch that created this row, for auditability. Optional —
  /// deleting the batch record keeps the transactions.
  importBatchId String?
  importBatch   FinanceImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, importKey])
  @@index([userId, date])
  @@index([accountId, date])
  @@index([billId])
  @@index([transferGroupId])
  @@index([importBatchId])
}

/// A recurring obligation — a bill or a subscription (`kind` separates the
/// two in the UI; they behave identically). `nextDueDate` is the one field
/// due-detection reads; marking a payment advances it along the recurrence
/// generated from `anchorDate`, which is what keeps "monthly on the 31st"
/// clamping to short months instead of drifting.
model Bill {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  /// The expected amount per occurrence; the actual paid amount lives on the
  /// linked transaction.
  amount Float

  /// bill | subscription
  kind     String @default("bill")
  /// See FINANCE_CATEGORIES in src/lib/enums.ts.
  category String @default("utilities")

  /// The account this is usually paid from. Optional, informational.
  accountId String?
  account   FinanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// once | weekly | monthly | quarterly | yearly
  recurrence String @default("monthly")
  /// First due date the recurrence generates from. Never edited by payments.
  anchorDate String // YYYY-MM-DD
  /// The next unpaid occurrence. Everything that asks "what is due?" reads
  /// this one column.
  nextDueDate String // YYYY-MM-DD
  /// A `once` bill that has been paid: nothing further is due, row kept for
  /// history.
  settledAt DateTime?

  autoPay Boolean @default(false)

  reminderEnabled     Boolean @default(true)
  /// Also remind this many days before the due date (0 = only on the day).
  reminderDaysBefore  Int     @default(3)

  lastPaidDate String?
  notes        String?
  archivedAt   DateTime?

  payments FinanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, nextDueDate])
  @@index([accountId])
}

/// Money being put aside toward something. `currentAmount` is maintained by
/// its own add/withdraw actions — deliberately not derived from the ledger,
/// so the goal works even for people who don't record transactions.
model SavingsGoal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  targetAmount  Float
  currentAmount Float   @default(0)
  targetDate    String? // YYYY-MM-DD
  notes         String?

  archivedAt DateTime?
  sortOrder  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A spending target for one category over one window. Spending in the window
/// counts against it; income, adjustments and transfers never do. One budget
/// per category per user — the unique key below is the whole identity, and the
/// period is a property of that one budget rather than a second axis, so
/// "groceries" can never mean two contradictory targets at once.
model Budget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// See FINANCE_CATEGORIES in src/lib/enums.ts. Bookkeeping categories
  /// (adjustment, transfer) and income are rejected in the action layer.
  category String
  /// Target spend per period, in the user's primary currency.
  amount   Float
  /// monthly | weekly — the window spending is measured over. Weekly windows
  /// follow the user's own weekStartsOn convention.
  period   String @default("monthly")

  /// Remind once per period when spending crosses this share of the target
  /// (50, 75, 90 …). Null = no threshold reminder. Delivery rides the one
  /// reminder ledger, keyed on budget + period start + threshold — see
  /// resolveBudgetThresholdReminder in src/lib/logic/reminders.ts.
  alertThresholdPercent Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId, alertThresholdPercent])
}

/// One CSV import run — the audit record behind "where did these rows come
/// from?". The transactions link back optionally, so deleting a batch record
/// never deletes ledger rows.
model FinanceImportBatch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The account the rows were imported into. Informational — SetNull keeps
  /// the audit record when the account goes.
  accountId String?
  account   FinanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  fileName String
  /// Rows in the file, excluding the header.
  rowCount      Int
  createdCount  Int
  /// Valid rows skipped as already-imported duplicates.
  skippedCount  Int
  /// Rows that failed validation and were never written.
  rejectedCount Int

  /// Set when the user undid this import. The batch row itself is never
  /// deleted — an import that happened stays in the history, now labelled as
  /// rolled back — and the stamp is what makes undo refuse to run twice.
  undoneAt DateTime?
  /// Rows the undo actually removed …
  undoneCount Int @default(0)
  /// … and rows it deliberately left in place because they had been edited
  /// away from what the import wrote (see src/lib/logic/finance-import.ts).
  keptCount   Int @default(0)

  transactions FinanceTransaction[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Inbox — one catchall queue for life admin
// ---------------------------------------------------------------------------

/// A captured scrap that doesn't belong to a module yet: something to decide,
/// follow up on, or file later. Deliberately not a second task system — no
/// projects, no priorities, no recurrence. Open → done | archived, that's all.
model InboxItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  notes String?

  /// open | done | archived
  status      String    @default("open")
  completedAt DateTime?

  /// Set when this capture was converted into a task. Records where it went
  /// and stops a second conversion from creating a duplicate; SetNull frees
  /// the item for re-conversion if the task is later deleted.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Documents & renewals — the life-admin things that expire
// ---------------------------------------------------------------------------

/// Something with an expiry or renewal date: a passport, an insurance policy,
/// a lease, a warranty. Deliberately the smallest model that can carry an
/// expiry reminder — no file storage, no attachments, no document numbers. It
/// records *when* a thing runs out and reminds you before it does; the thing
/// itself stays wherever you keep it.
///
/// Renewal is an edit: move `expiryDate` forward and the reminder re-arms on
/// its own, because the delivery key embeds the date (exactly how a bill's
/// nextDueDate behaves).
model LifeDocument {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  /// id | insurance | lease | warranty | licence | membership | other
  /// (validated in src/lib/enums.ts)
  kind String @default("other")
  /// Who issued or holds it — an insurer, a landlord, an agency. Optional.
  issuer String?

  expiryDate String // YYYY-MM-DD
  notes      String?

  reminderEnabled Boolean @default(true)
  /// Remind this many days before the expiry date (0 = only on the day).
  reminderDaysBefore Int @default(30)

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, expiryDate])
  @@index([userId, archivedAt])
}

/// Generic "pin this" across domains — foods, workouts, templates, habits.
model FavoriteItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// food | workout_template | meal_template | schedule_template | habit
  kind       String
  refId      String
  label      String
  sortOrder  Int    @default(0)
  useCount   Int    @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, kind, refId])
  @@index([userId, kind])
}
