{
  "name": "personal-os",
  "version": "1.0.0",
  "private": true,
  "description": "A private, local-first personal operating system: daily planner, habits, nutrition, workouts and health in one desktop web app.",
  "scripts": {
    "env": "node scripts/ensure-env.mjs",
    "predev": "node scripts/ensure-env.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-env.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "predb:seed": "node scripts/ensure-env.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "predb:migrate": "node scripts/ensure-env.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "predb:backfill": "node scripts/ensure-env.mjs",
    "db:backfill": "tsx prisma/migrate-data.ts",
    "predb:reset": "node scripts/guard-local-db.mjs",
    "db:reset": "prisma migrate reset --force",
    "presetup": "node scripts/ensure-env.mjs",
    "setup": "prisma generate && prisma migrate deploy && npm run db:backfill && npm run db:seed",
    "presetup:empty": "node scripts/ensure-env.mjs",
    "setup:empty": "prisma generate && prisma migrate deploy && npm run db:backfill"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.545.0",
    "next": "15.5.22",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.12.1",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
